# Supabase (Project Settings → API). Use the EU (Frankfurt) project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_…) — or the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) — or the legacy "service_role" key. Server only, never expose.
SUPABASE_SECRET_KEY=

# Random string (≥ 32 chars). Used to derive the daily rotating salt for cookieless visitor hashes.
# Generate with: openssl rand -hex 32
ANALYTICS_SALT_SECRET=

# Web3Forms access key (public by design; sends the e-mail notification for new leads).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=4927acbd-7129-4bb0-973a-c8e8c6b42828
